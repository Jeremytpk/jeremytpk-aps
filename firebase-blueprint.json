{
  "entities": {
    "User": {
      "title": "User",
      "description": "Owner user account details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "businessName": { "type": "string" },
        "role": { "type": "string", "enum": ["espace", "admin", "personal", "worker"] },
        "suspended": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "approved": { "type": "boolean" },
        "isCleaningAllowed": { "type": "boolean" },
        "parentId": { "type": "string" },
        "password": { "type": "string" },
        "isCleaningAccessRequested": { "type": "boolean" },
        "cleaningAccessRequestedAt": { "type": "string" },
        "phone": { "type": "string" },
        "loginCode": { "type": "string" }
      },
      "required": ["id", "fullName", "email", "businessName", "role", "suspended", "createdAt"]
    },
    "Apartment": {
      "title": "Apartment",
      "description": "An apartment managed by a homeowner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "rating": { "type": "number" },
        "reviews": { "type": "integer" }
      },
      "required": ["id", "ownerId", "name", "address", "status", "price"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A travel booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "apartmentId": { "type": "string" },
        "ownerId": { "type": "string" },
        "guestName": { "type": "string" },
        "guestEmail": { "type": "string" },
        "guestPhone": { "type": "string" },
        "guestHasWhatsApp": { "type": "boolean" },
        "checkIn": { "type": "string" },
        "checkOut": { "type": "string" },
        "status": { "type": "string" },
        "totalAmount": { "type": "number" }
      },
      "required": ["id", "apartmentId", "ownerId", "guestName", "checkIn", "checkOut", "status", "totalAmount"]
    },
    "CleaningTask": {
      "title": "CleaningTask",
      "description": "Ménage rotation task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "apartmentId": { "type": "string" },
        "ownerId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "cleanerId": { "type": "string" },
        "cleanerName": { "type": "string" }
      },
      "required": ["id", "apartmentId", "ownerId", "date", "status"]
    },
    "CommunicationThread": {
      "title": "CommunicationThread",
      "description": "Communication chat thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "apartmentId": { "type": "string" },
        "ownerId": { "type": "string" },
        "guestName": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "messages": {
          "type": "array"
        }
      },
      "required": ["id", "apartmentId", "ownerId", "guestName", "lastUpdated", "messages"]
    },
    "Review": {
      "title": "Review",
      "description": "Guest reviews for concierges",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conciergeId": { "type": "string" },
        "apartmentId": { "type": "string" },
        "rating": { "type": "number" },
        "content": { "type": "string" },
        "guestName": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "guestId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": [
        "id",
        "conciergeId",
        "rating",
        "content",
        "guestName",
        "isAnonymous",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account documents mapped by auth ID"
    },
    "/apartments/{apartmentId}": {
      "schema": "Apartment",
      "description": "Apartments collection"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Bookings collection"
    },
    "/cleaningTasks/{cleaningTaskId}": {
      "schema": "CleaningTask",
      "description": "Cleaning tasks collection"
    },
    "/threads/{threadId}": {
      "schema": "CommunicationThread",
      "description": "Threads collection"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Guest reviews of concierges"
    }
  }
}
